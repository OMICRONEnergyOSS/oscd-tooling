{
  "name": "@omicronenergy/oscd-tooling",
  "version": "0.0.6",
  "description": "Centralized tooling and CLI for OMICRON Energy OSS plugins (prototype).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OMICRONEnergyOSS/oscd-tooling.git"
  },
  "type": "module",
  "bin": {
    "oscd": "./bin/oscd.js"
  },
  "main": "dist/oscd.js",
  "exports": {
    ".": "./dist/oscd.js",
    "./configs/*": "./configs/*",
    "./configs/eslint.config.js": {
      "types": "./configs/eslint.config.d.ts",
      "default": "./configs/eslint.config.js"
    },
    "./configs/rollup.config.js": {
      "types": "./configs/rollup.config.d.ts",
      "default": "./configs/rollup.config.js"
    },
    "./configs/web-test-runner.config.js": {
      "types": "./configs/web-test-runner.config.d.ts",
      "default": "./configs/web-test-runner.config.js"
    },
    "./configs/commitlint.config.js": {
      "types": "./configs/commitlint.config.d.ts",
      "default": "./configs/commitlint.config.js"
    },
    "./configs/lint-staged.config.js": {
      "types": "./configs/lint-staged.config.d.ts",
      "default": "./configs/lint-staged.config.js"
    },
    "./configs/ncurc.config.js": {
      "types": "./configs/ncurc.config.d.ts",
      "default": "./configs/ncurc.config.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc -w",
    "prepublishOnly": "npm run build",
    "lint": "eslint . --ext .ts",
    "format": "eslint . --fix",
    "updates": "ncu --configFilePath ./configs --configFileName ncurc.config.js",
    "update": "ncu --configFilePath ./configs --configFileName ncurc.config.js --upgrade && npm install"
  },
  "keywords": [
    "oscd",
    "tooling",
    "omon"
  ],
  "author": "OMICRON",
  "license": "MIT",
  "dependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@lit/localize-tools": "^0.8.2",
    "@open-wc/eslint-config": "^13.1.0",
    "@open-wc/testing": "^4.0.0",
    "@openscd/oscd-editor": "^1.8.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/mocha": "^10.0.10",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@web/dev-server": "^0.4.6",
    "@web/dev-server-esbuild": "^1.0.5",
    "@web/dev-server-polyfill": "^1.0.6",
    "@web/rollup-plugin-html": "^2.4.1",
    "@web/rollup-plugin-import-meta-assets": "^2.3.3",
    "@web/test-runner": "0.20.2",
    "@web/test-runner-commands": "^0.9.0",
    "@web/test-runner-playwright": "0.11.1",
    "@web/test-runner-visual-regression": "0.10.0",
    "chalk": "^6.0.0",
    "chokidar-cli": "^3.0.0",
    "commander": "^15.0.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-lit": "^2.3.1",
    "eslint-plugin-lit-a11y": "^5.1.1",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "eslint-plugin-tsdoc": "^0.5.3",
    "eslint-plugin-wc": "^3.1.0",
    "gh-pages": "^6.3.0",
    "lint-staged": "^17.5.1",
    "npm-check-updates": "^23.1.0",
    "pixelmatch": "^7.2.0",
    "playwright": "1.59.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.8",
    "rimraf": "^6.1.3",
    "rollup": "^4.63.3",
    "rollup-plugin-copy": "^3.5.0",
    "sinon": "^22.1.0",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.3"
  }
}
